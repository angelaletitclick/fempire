# Kopieren nach .env.local und echte Werte eintragen. .env.local nie committen.

# Öffentliche Basis-URL ohne Slash am Ende (für Metadata, Sitemap, Mail-Links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key
# Project Settings → API → service_role. Nur serverseitig, umgeht RLS. Nie mit NEXT_PUBLIC_ präfixen.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# Resend: API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Absender, Domain muss in Resend verifiziert sein
MAIL_FROM="FEMPIRE CLUB <bewerbung@fempireclub.de>"
# Antwortadresse für Mails an Bewerberinnen
MAIL_REPLY_TO=hallo@fempireclub.de
# Empfängerinnen der Benachrichtigung über neue Bewerbungen, kommagetrennt
MAIL_NOTIFY_TO=angela@example.com,maria@example.com

# Zufälliger langer String, mit dem IP-Adressen vor dem Speichern gehasht werden
# z. B. erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=change-me
